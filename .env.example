NODE_ENV=development

# Backend Express. Por defecto corre en el 4000 (el 3000 es de Next.js).
# No descomentes PORT si vas a compartir este archivo con el frontend:
# Next.js tambien lee process.env.PORT y arrancaria en 4000.
# PORT=4000

JWT_SECRET=cambia-este-secreto-en-produccion

# Base de datos
#   sqlite  (defecto, cero configuracion) | mysql | postgres
DB_DIALECT=sqlite
DB_SQLITE_STORAGE=./psicogestion.sqlite

# Solo para mysql | postgres
DB_HOST=localhost
DB_PORT=3306
DB_NAME=psicogestion
DB_USER=root
DB_PASSWORD=

# URL base del backend para el frontend (Next.js).
# Si no existe, lib/auth-api.ts usa http://localhost:4000
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Correo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@psicogestion.com

# Enlace a la aplicacion frontend para los correos de recuperacion
# (el navegador abre /reset-password?token=... en Next.js, por eso el 3000)
APP_URL=http://localhost:3000

# ---- Seguridad (Iteración 2-R) ----
# Obligatorio en producción: mínimo 32 caracteres aleatorios.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# Orígenes del frontend permitidos por CORS (separados por coma). APP_URL ya se incluye.
# CORS_ORIGINS=https://psicogestion.ejemplo.mx

# Registro de cuentas: "lista_blanca" (solo correos de correos_autorizados; defecto en producción)
# o "dominio" (cualquier correo institucional; defecto en desarrollo).
# REGISTRO_MODO=lista_blanca
# Dominios institucionales adicionales a uady.mx (separados por coma).
# DOMINIOS_INSTITUCIONALES_EXTRA=

# Detrás de un proxy inverso (Caddy/Nginx): número de saltos o "true".
# TRUST_PROXY=1

# Migraciones al arrancar: true/false. Defecto: true en desarrollo, false en producción
# (en producción se ejecuta "npm run migrate" durante el despliegue).
# DB_AUTO_MIGRATE=

# PostgreSQL gestionado con TLS obligatorio.
# DB_SSL=true

# ---- Citas (Iteración 3) ----
# Envío periódico de correos de citas (cada 15 s). false = desactivar (útil en réplicas extra).
# NOTIFICACIONES_WORKER=true

# Solo pruebas: ejecutar la suite contra PostgreSQL en lugar de SQLite en memoria.
# TEST_DATABASE_URL=postgres://usuario:clave@localhost:5432/psicogestion_test

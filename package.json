{
  "name": "psicogestion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "node --watch src/server.js",
    "dev:client": "npm --prefix front run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --prefix front run build",
    "start:server": "node src/server.js",
    "start:client": "npm --prefix front run start",
    "test": "jest --runInBand --roots tests",
    "server": "node src/server.js",
    "test:backend": "jest --runInBand --roots tests",
    "migrate": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:status": "node scripts/migrate.js status",
    "usuarios:autorizar": "node scripts/autorizar-correo.js",
    "usuarios:rol": "node scripts/asignar-rol.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "joi": "^17.6.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.2.0",
    "nodemailer": "^6.9.13",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.6.0",
    "sharp": "^0.35.5",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "sqlite3": "^5.1.0",
    "supertest": "^7.0.0"
  }
}

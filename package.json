{
  "name": "psicogestion",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "npm": ">=7.0.0"
  },
  "workspaces": [
    "front"
  ],
  "scripts": {
    "dev:server": "node --watch src/server.js",
    "dev:client": "npm run dev --workspace front",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build:client",
    "build:client": "npm run build --workspace front",
    "start:server": "node src/server.js",
    "start:client": "npm run start --workspace front",
    "test": "jest --config jest.config.cjs --runInBand",
    "server": "node src/server.js",
    "test:backend": "jest --config jest.config.cjs --runInBand",
    "test:backend:coverage": "jest --config jest.config.cjs --coverage --runInBand",
    "test:frontend": "npm run test --workspace front",
    "test:frontend:coverage": "npm run test:coverage --workspace front",
    "test:pg": "node scripts/test-postgres.js",
    "test:e2e": "playwright test",
    "test:e2e:perf": "playwright test --grep @perf",
    "test:e2e:install": "playwright install chromium",
    "lint": "eslint src tests scripts migrations",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\" \"migrations/**/*.js\" \"front/**/*.{js,jsx,ts,tsx,json,css}\" \"*.{json,md}\" \"docs/**/*.md\"",
    "typecheck": "tsc --noEmit --project front/tsconfig.json",
    "migrate": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:status": "node scripts/migrate.js status",
    "usuarios:autorizar": "node scripts/autorizar-correo.js",
    "usuarios:rol": "node scripts/asignar-rol.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.2.0",
    "nodemailer": "^6.9.13",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.6.0",
    "sharp": "^0.35.5",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.14.0",
    "concurrently": "^9.0.1",
    "eslint": "^10.0.0",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.6.2",
    "sqlite3": "^5.1.0",
    "supertest": "^7.0.0"
  }
}
